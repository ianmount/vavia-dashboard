# Upstash Redis — required for live sync across all viewers
# Find these values in your Upstash console under your database → REST API.
# In Vercel: add them as Environment Variables in Project Settings.
# For local dev: copy this file to .env.local and fill in the values.

UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
