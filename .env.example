# Supabase — required for live sync across all viewers
# These are auto-injected when you connect a Supabase project in the Vercel dashboard.
# For local dev run: vercel env pull .env.local  (requires Vercel CLI)

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
